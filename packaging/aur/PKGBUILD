# Maintainer: Edge Marketing Agency <software@edgemarketing.art>
pkgname=knob-controller
pkgver=1.0.0
pkgrel=1
pkgdesc="Control your keyboard knob your way: scroll, volume, cursor, brightness, zoom or any command"
arch=('any')
url="https://github.com/mrallanodreman/KNOBController"
license=('MIT')
depends=('python' 'gtk3' 'python-cairo' 'libx11')
source=("https://github.com/mrallanodreman/KNOBController/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('a56751e1b1914378dc975c171c0fe146791cf023994513cfb6f7009fce3eea66')

package() {
  install -Dm755 "$srcdir/backend/knob-controller" "$pkgdir/usr/local/bin/knob-controller"
  install -Dm755 "$srcdir/native-app/knob-controller-native" "$pkgdir/usr/local/bin/knob-controller-native"
  install -Dm644 "$srcdir/packaging/knob-controller.desktop" "$pkgdir/usr/share/applications/knob-controller.desktop"
  install -Dm644 "$srcdir/packaging/knob-controller.service" "$pkgdir/usr/lib/systemd/system/knob-controller.service"
}