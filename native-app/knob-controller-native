def load_calibration():
    try:
        data = json.load(open(CALIBRATION_PATH))
        return float(data.get("deg_per_tick", 18.0)), float(data.get("angle_offset", 0.0))
    except Exception:
        return 18.0, 0.0


def save_calibration(deg_per_tick, angle_offset):
    try:
        os.makedirs(os.path.dirname(CALIBRATION_PATH), exist_ok=True)
        json.dump({"deg_per_tick": deg_per_tick, "angle_offset": angle_offset}, open(CALIBRATION_PATH, "w"))
    except Exception:
        pass


def load_pixbuf(path, width):
    """Carga un PNG y lo escala a `width` de ancho manteniendo proporción.
    Si el asset no está instalado, devuelve None — quien llame decide el
    respaldo, la app nunca debe caerse por falta de un logo."""
    try:
        pix = GdkPixbuf.Pixbuf.new_from_file(path)
        ratio = pix.get_height() / pix.get_width()
        return pix.scale_simple(width, round(width * ratio), GdkPixbuf.InterpType.BILINEAR)
    except Exception:
        return None

class Knob(Gtk.DrawingArea):
    """Perilla dibujada a mano: arco de progreso, aguja con glow, y un
    anillo de choque (ripple) que se expande y se apaga al recibir un clic
    físico — distinto del pulso de giro, para que se sientan como dos
    gestos distintos."""

    def __init__(self):
        super().__init__()
        self.angle = 0.0
        self.pulse_until = 0.0
        self.ripple_started = None
        # Grados que gira la aguja por cada tick del knob real. El encoder
        # físico no manda su ángulo absoluto, solo pasos — así que esto es
        # lo único que decide si la perilla en pantalla gira al mismo ritmo
        # que la de verdad o "da más vueltas". Calibrable en vivo desde la
        # UI (- / +), no un número fijo adivinado.
        self.deg_per_tick = 18.0
        # Sin sensor absoluto, el software no sabe dónde apunta la muesca
        # física — este offset es la corrección manual para que la aguja
        # digital arranque alineada con la posición real del knob.
        self.angle_offset = 0.0
        self.set_size_request(340, 340)

    def turn(self, delta):
        self.angle += delta * self.deg_per_tick
        self.pulse_until = time.time() + 0.22
        self.queue_draw()

    def click(self):
        self.ripple_started = time.time()
        self.queue_draw()

    def do_draw(self, cr):
        alloc = self.get_allocation()
        w, h = alloc.width, alloc.height
        cx, cy = w / 2, h / 2
        r = min(w, h) * 0.42
        pulse = 1.018 if time.time() < self.pulse_until else 1.0
        now = time.time()

        cr.save()
        cr.translate(cx, cy)

        # Sombra de contacto: ancla el disco, look de hardware físico en vez
        # de icono flotando sobre un halo de colores.
        shadow = self._radial(0, r * 0.10, r * 1.2)
        shadow.add_color_stop_rgba(0.0, 0, 0, 0, 0.5)
        shadow.add_color_stop_rgba(1.0, 0, 0, 0, 0.0)
        cr.set_source(shadow)
        cr.arc(0, r * 0.10, r * 1.2, 0, math.tau)
        cr.fill()

        # Anillo de choque del clic: fino y metálico, no un halo cian ancho.
        if self.ripple_started is not None:
            t = now - self.ripple_started
            if t < 0.45:
                k = t / 0.45
                cr.set_line_width(2.5 * (1 - k))
                cr.set_source_rgba(0.92, 0.95, 1.0, 0.85 * (1 - k))
                cr.arc(0, 0, r * (1.05 + 0.3 * k), 0, math.tau)
                cr.stroke()
                GLib.timeout_add(16, self._redraw_if_rippling)
            else:
                self.ripple_started = None

        cr.scale(pulse, pulse)

        # Cuerpo: un solo material (aluminio oscuro), sin arcos de colores.
        body = self._radial(-r * 0.35, -r * 0.42, r * 1.6)
        body.add_color_stop_rgb(0.0, 0.24, 0.25, 0.28)
        body.add_color_stop_rgb(0.45, 0.13, 0.135, 0.15)
        body.add_color_stop_rgb(1.0, 0.045, 0.047, 0.055)
        cr.set_source(body)
        cr.arc(0, 0, r, 0, math.tau)
        cr.fill()

        # Muescas del borde (knurling): el detalle que hace que se sienta
        # una perilla física de verdad y no un botón plano digital.
        for i in range(48):
            cr.save()
            cr.rotate(i * (math.tau / 48))
            shade = 0.16 if i % 2 == 0 else 0.08
            cr.set_source_rgba(1, 1, 1, shade)
            cr.set_line_width(1.6)
            cr.move_to(0, -r * 0.94)
            cr.line_to(0, -r * 1.0)
            cr.stroke()
            cr.restore()

        # Bisel de precisión.
        cr.set_line_width(1.2)
        cr.set_source_rgba(1, 1, 1, 0.14)
        cr.arc(0, 0, r * 0.90, 0, math.tau)
        cr.stroke()

        # Un solo punto de luz especular, no gradiente difuso genérico.
        spec = self._radial(-r * 0.32, -r * 0.40, r * 0.55)
        spec.add_color_stop_rgba(0.0, 1, 1, 1, 0.20)
        spec.add_color_stop_rgba(1.0, 1, 1, 1, 0.0)
        cr.set_source(spec)
        cr.arc(0, 0, r * 0.85, 0, math.tau)
        cr.fill()

        cr.rotate(math.radians(self.angle + self.angle_offset))
        cr.set_line_width(3)
        cr.set_line_cap(2)
        line = self._linear(0, -r * 0.84, 0, -r * 0.42)
        line.add_color_stop_rgb(0.0, 1.0, 1.0, 1.0)
        line.add_color_stop_rgb(1.0, 0.55, 0.62, 0.72)
        cr.set_source(line)
        cr.move_to(0, -r * 0.84)
        cr.line_to(0, -r * 0.44)
        cr.stroke()
        cr.restore()

        if time.time() < self.pulse_until:
            GLib.timeout_add(30, self._redraw_if_pulsing)
        return False

    def _redraw_if_pulsing(self):
        self.queue_draw()
        return time.time() < self.pulse_until

    def _redraw_if_rippling(self):
        self.queue_draw()
        return self.ripple_started is not None

    def _radial(self, x, y, r):
        import cairo

        return cairo.RadialGradient(x, y, 0, 0, 0, r)

    def _linear(self, x0, y0, x1, y1):
        import cairo

        return cairo.LinearGradient(x0, y0, x1, y1)

    def _rounded_rect(self, cr, x, y, w, h, radius):
        cr.new_sub_path()
        cr.arc(x + w - radius, y + radius, radius, -math.pi / 2, 0)
        cr.arc(x + w - radius, y + h - radius, radius, 0, math.pi / 2)
        cr.arc(x + radius, y + h - radius, radius, math.pi / 2, math.pi)
        cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
        cr.close_path()


class Mark(Gtk.DrawingArea):
    """Marca pequeña junto al título: un mini-knob, mismo lenguaje visual
    que la perilla grande, para que la cabecera no sea solo texto plano."""

    def __init__(self):
        super().__init__()
        self.set_size_request(40, 40)

    def do_draw(self, cr):
        alloc = self.get_allocation()
        cx, cy = alloc.width / 2, alloc.height / 2
        r = min(alloc.width, alloc.height) * 0.46
        cr.save()
        cr.translate(cx, cy)
        import cairo

        grad = cairo.RadialGradient(-r * 0.3, -r * 0.3, 0, 0, 0, r * 1.4)
        grad.add_color_stop_rgb(0.0, 0.30, 0.55, 0.95)
        grad.add_color_stop_rgb(1.0, 0.10, 0.13, 0.30)
        cr.set_source(grad)
        cr.arc(0, 0, r, 0, math.tau)
        cr.fill()
        cr.set_line_width(3)
        cr.set_source_rgba(0.97, 0.99, 1.0, 0.95)
        cr.move_to(0, -r * 0.05)
        cr.line_to(0, -r * 0.68)
        cr.stroke()
        cr.restore()
        return False


