    def _section_label(self, text):
        lab = Gtk.Label(label=text, xalign=0)
        lab.get_style_context().add_class("section-label")
        return lab

    def _pill(self, label, handler, small=False):
        btn = Gtk.Button(label=label)
        ctx = btn.get_style_context()
        ctx.add_class("pill")
        if small:
            ctx.add_class("small")
        btn.connect("clicked", handler)
        return btn

    def _mode_combo(self):
        combo = Gtk.ComboBoxText()
        for m in ("scroll", "volume", "text", "brightness", "zoom"):
            combo.append(m, MODE_LABELS.get(m, m))
        combo.set_active_id("scroll")
        return combo

    def _stat(self, grid, col, label, value):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.get_style_context().add_class("stat-box")
        lab = Gtk.Label(label=label, xalign=0)
        lab.get_style_context().add_class("stat-label")
        val = Gtk.Label(label=value, xalign=0)
        val.get_style_context().add_class("stat-value")
        box.pack_start(lab, False, False, 0)
        box.pack_start(val, False, False, 0)
        grid.attach(box, col, 0, 1, 1)
        return val

    def _ensure_service(self):
        subprocess.run(["sudo", "systemctl", "start", "knob-controller.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    def on_close(self, *_args):
        self.close_cleanly()
        return True

    def close_cleanly(self):
        if self.mode == "volume":
            # El volumen es el comportamiento nativo del hardware: sin
            # demonio agarrando el dispositivo, las teclas de verdad llegan
            # solas, no hace falta nada corriendo.
            subprocess.run(["sudo", "systemctl", "stop", "knob-controller.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        self.quit()

    def refresh_status(self):
        try:
            data = json.loads(urllib.request.urlopen(API + "/api/status", timeout=2).read())
            self.apply_mode(data.get("mode", "scroll"))
            self.apply_scroll_step(data.get("scroll_step", 1))
            self.apply_scroll_invert(data.get("scroll_invert", False))
            self.apply_presets(data.get("presets"))
            self.apply_click_modes(data.get("click_modes"))
            self.render_shortcuts(data.get("shortcuts") or [], data.get("active_shortcut"))
            self.status_label.set_text(data.get("device", "dispositivo") + " activo")
            self.status_dot.get_style_context().remove_class("dot-warn")
            self.status_dot.get_style_context().add_class("dot-ok")
        except Exception:
            self.status_label.set_text("Servicio no disponible")
            self.status_dot.get_style_context().remove_class("dot-ok")
            self.status_dot.get_style_context().add_class("dot-warn")
        return False

    def set_mode(self, mode):
        req = urllib.request.Request(API + "/api/mode", data=json.dumps({"mode": mode}).encode(), headers={"content-type": "application/json"}, method="POST")
        try:
            data = json.loads(urllib.request.urlopen(req, timeout=2).read())
            self.apply_mode(data.get("mode", mode))
        except Exception as exc:
            self.status_label.set_text("No se pudo cambiar modo: " + str(exc))

    def adjust_scroll_step(self, step):
        new_step = max(1, min(10, self.scroll_step + step))
        req = urllib.request.Request(API + "/api/scroll-step", data=json.dumps({"scroll_step": new_step}).encode(), headers={"content-type": "application/json"}, method="POST")
        try:
            data = json.loads(urllib.request.urlopen(req, timeout=2).read())
            self.apply_scroll_step(data.get("scroll_step", new_step))
        except Exception as exc:
            self.status_label.set_text("No se pudo cambiar el paso de scroll: " + str(exc))

    def apply_mode(self, mode):
        self.mode = mode
        self.mode_value.set_text(mode)
        for name, btn in [("scroll", self.scroll_btn), ("volume", self.volume_btn), ("text", self.text_btn), ("brightness", self.brightness_btn), ("zoom", self.zoom_btn)]:
            btn.get_style_context().remove_class("active")
            if mode == name:
                btn.get_style_context().add_class("active")

    def apply_scroll_step(self, step):
        self.scroll_step = int(step)
        self.scroll_step_value.set_text(str(self.scroll_step))

    def toggle_scroll_invert(self):
        req = urllib.request.Request(API + "/api/scroll-invert", data=json.dumps({"scroll_invert": not self.scroll_invert}).encode(), headers={"content-type": "application/json"}, method="POST")
        try:
            data = json.loads(urllib.request.urlopen(req, timeout=2).read())
            self.apply_scroll_invert(data.get("scroll_invert", False))
        except Exception as exc:
            self.status_label.set_text("No se pudo invertir: " + str(exc))

    def apply_scroll_invert(self, value):
        self.scroll_invert = bool(value)
        self.invert_btn.get_style_context().remove_class("active")
        if self.scroll_invert:
            self.invert_btn.get_style_context().add_class("active")

    def render_shortcuts(self, shortcuts, active_id=None):
        self.shortcuts = shortcuts or []
        self.active_shortcut_id = active_id
        for child in self.shortcut_box.get_children():
            self.shortcut_box.remove(child)
        self.shortcut_rows = {}
        if not self.shortcuts:
            lab = Gtk.Label(label="Sin shortcuts configurados", xalign=0)
            lab.get_style_context().add_class("copy")
            self.shortcut_box.pack_start(lab, False, False, 0)
            return
        for sc in self.shortcuts:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.get_style_context().add_class("shortcut-row")
            if active_id and sc.get("id") == active_id:
                row.get_style_context().add_class("active")
            mod_label = " + ".join(KEY_LABELS.get(m, m) for m in sc.get("mods", []))
            sc_id = sc.get("id", "")
            cb = Gtk.CheckButton.new_with_label(mod_label + " + rueda")
            cb.set_active(sc.get("enabled", True))
            cb.connect("toggled", lambda _b, sid=sc_id: self.toggle_shortcut(sid, _b.get_active()))
            row.pack_start(cb, False, False, 0)
            if sc.get("type") == "command":
                result_text = " ⚙ " + sc.get("command", "")
            else:
                result_text = " → " + (self._preset_name_for(sc) or ",".join(KEY_LABELS.get(k, k) for k in sc.get("up", [])))
            result_label = Gtk.Label(label=result_text, xalign=0)
            result_label.get_style_context().add_class("shortcut-name")
            row.pack_start(result_label, False, False, 0)
            if active_id and sc.get("id") == active_id:
                tag = Gtk.Label(label="ACTIVO")
                tag.get_style_context().add_class("shortcut-active-tag")
                row.pack_end(tag, False, False, 0)
            self.shortcut_box.pack_start(row, False, False, 0)
            self.shortcut_rows[sc_id] = row
        self.shortcut_box.show_all()

    def _preset_name_for(self, sc):
        for preset in self.presets.values():
            if preset.get("up") == sc.get("up") and preset.get("down") == sc.get("down"):
                return preset.get("name")
        return None

    def apply_presets(self, presets):
        self.presets = presets or {}

    def apply_click_modes(self, click_modes):
        # Al aplicar el estado que manda el backend, los combos disparan su
        # propio "changed" — el flag evita reenviar ese mismo valor de vuelta.
        if not click_modes or len(click_modes) != 2:
            return
        self.click_modes = list(click_modes)
        self._applying_click_modes = True
        self.click_mode_combo_a.set_active_id(click_modes[0])
        self.click_mode_combo_b.set_active_id(click_modes[1])
        self._applying_click_modes = False

    def on_click_mode_changed(self, changed_combo, other_combo):
        if getattr(self, "_applying_click_modes", False):
            return
        a = self.click_mode_combo_a.get_active_id()
        b = self.click_mode_combo_b.get_active_id()
        if a == b:
            for row in other_combo.get_model():
                candidate = row[0]
                if candidate != a:
                    self._applying_click_modes = True
                    other_combo.set_active_id(candidate)
                    self._applying_click_modes = False
                    break
            a = self.click_mode_combo_a.get_active_id()
            b = self.click_mode_combo_b.get_active_id()
        req = urllib.request.Request(
            API + "/api/click-modes",
            data=json.dumps({"click_modes": [a, b]}).encode(),
            headers={"content-type": "application/json"},
            method="POST",
        )
        try:
            urllib.request.urlopen(req, timeout=2)
        except Exception as exc:
            self.status_label.set_text("No se pudo cambiar el clic: " + str(exc))

    def start_capture(self):
        req = urllib.request.Request(API + "/api/capture", data=json.dumps({"capture": True}).encode(), headers={"content-type": "application/json"}, method="POST")
        try:
            urllib.request.urlopen(req, timeout=2)
            self.status_label.set_text("Capturando... mantén Alt/Ctrl/Shift y gira el knob")
        except Exception as exc:
            self.status_label.set_text("No se pudo iniciar la captura: " + str(exc))

    def on_captured(self, mods):
        if not mods:
            self.status_label.set_text("No se detectó modificador — mantén Alt/Ctrl/Shift mientras giras")
            return
        self.open_shortcut_dialog(mods)

    def open_shortcut_dialog(self, mods):
        dialog = Gtk.Dialog(title="Nuevo shortcut", transient_for=self.window, modal=True)
        dialog.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Guardar", Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(8)
        box.set_border_width(16)

        mod_label = Gtk.Label(label="Combinación: " + " + ".join(KEY_LABELS.get(m, m) for m in mods) + " + rueda", xalign=0)
        box.pack_start(mod_label, False, False, 0)

        name_entry = Gtk.Entry()
        name_entry.set_placeholder_text("Nombre (ej: Abrir terminal)")
        box.pack_start(name_entry, False, False, 0)

        type_combo = Gtk.ComboBoxText()
        type_combo.append("preset", "Acción predeterminada")
        type_combo.append("command", "Ejecutar comando")
        type_combo.set_active_id("preset")
        box.pack_start(type_combo, False, False, 0)

        preset_combo = Gtk.ComboBoxText()
        for pid, preset in self.presets.items():
            preset_combo.append(pid, preset.get("name", pid))
        if self.presets:
            preset_combo.set_active(0)
        box.pack_start(preset_combo, False, False, 0)

        cmd_entry = Gtk.Entry()
        cmd_entry.set_placeholder_text("Comando (ej: xdg-open https://github.com)")
        cmd_entry.set_visible(False)
        box.pack_start(cmd_entry, False, False, 0)

        def on_type_changed(_c):
            is_command = type_combo.get_active_id() == "command"
            cmd_entry.set_visible(is_command)
            preset_combo.set_visible(not is_command)

        type_combo.connect("changed", on_type_changed)
        on_type_changed(type_combo)

        dialog.show_all()
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            name = name_entry.get_text().strip() or "Shortcut"
            if type_combo.get_active_id() == "command":
                command = cmd_entry.get_text().strip()
                if command:
                    self.save_shortcut({"name": name, "mods": mods, "type": "command", "command": command})
                else:
                    self.status_label.set_text("Escribe un comando antes de guardar")
            else:
                preset_id = preset_combo.get_active_id()
                preset = self.presets.get(preset_id)
                if preset:
                    self.save_shortcut({"name": name, "mods": mods, "type": "key", "up": preset["up"], "down": preset["down"]})
                else:
                    self.status_label.set_text("Elige una acción predeterminada")
        dialog.destroy()

    def save_shortcut(self, shortcut):
        req = urllib.request.Request(
            API + "/api/shortcut-add",
            data=json.dumps({"shortcut": shortcut}).encode(),
            headers={"content-type": "application/json"},
            method="POST",
        )
        try:
            data = json.loads(urllib.request.urlopen(req, timeout=2).read())
            self.render_shortcuts(data.get("shortcuts"), self.active_shortcut_id)
            self.status_label.set_text("Shortcut guardado")
        except Exception as exc:
            self.status_label.set_text("No se pudo guardar el shortcut: " + str(exc))

    def toggle_shortcut(self, sc_id, enabled):
        req = urllib.request.Request(
            API + "/api/shortcut-enabled",
            data=json.dumps({"id": sc_id, "enabled": enabled}).encode(),
            headers={"content-type": "application/json"},
            method="POST",
        )
        try:
            data = json.loads(urllib.request.urlopen(req, timeout=2).read())
            self.render_shortcuts(data.get("shortcuts"), self.active_shortcut_id)
        except Exception as exc:
            self.status_label.set_text("No se pudo cambiar el shortcut: " + str(exc))

    def highlight_shortcut(self, sc_id):
        self.active_shortcut_id = sc_id
        for sid, row in self.shortcut_rows.items():
            ctx = row.get_style_context()
            if sid == sc_id:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")

    def apply_turn(self, delta):
        self.ticks += delta
        self.ticks_value.set_text(str(self.ticks))
        self.dir_value.set_text("derecha / arriba" if delta > 0 else "izquierda / abajo")
        self.knob.turn(delta)

    def apply_click_event(self, mode):
        self.last_click_label = mode
        self.click_value.set_text(mode)
        self.knob.click()

    def adjust_calibration(self, step):
        # Sin sensor de posición absoluta, no hay forma de "leer" cuántos
        # grados gira el encoder real por clic — por eso es ajuste manual:
        # gira el knob una vuelta completa y sube/baja hasta que la aguja
        # digital complete también una vuelta, ni más ni menos.
        self.deg_per_tick = max(1.0, min(90.0, self.deg_per_tick + step))
        self.knob.deg_per_tick = self.deg_per_tick
        self.cal_value.set_text(f"{self.deg_per_tick:.0f}°")
        save_calibration(self.deg_per_tick, self.angle_offset)

    def on_offset_changed(self, spin):
        self.angle_offset = spin.get_value()
        self.knob.angle_offset = self.angle_offset
        self.knob.queue_draw()
        save_calibration(self.deg_per_tick, self.angle_offset)

    def event_loop(self):
        while True:
            try:
                conn = http.client.HTTPConnection("127.0.0.1", 8766, timeout=30)
                conn.request("GET", "/events")
                resp = conn.getresponse()
                while resp.status == 200:
                    line = resp.readline().decode("utf-8", "replace").strip()
                    if not line.startswith("data: "):
                        continue
                    data = json.loads(line[6:])
                    kind = data.get("type")
                    if kind == "mode":
                        GLib.idle_add(self.apply_mode, data.get("mode", "scroll"))
                    elif kind == "turn":
                        GLib.idle_add(self.apply_turn, int(data.get("delta", 0)))
                        if data.get("shortcut"):
                            GLib.idle_add(self.highlight_shortcut, data.get("shortcut"))
                    elif kind == "shortcuts":
                        GLib.idle_add(self.render_shortcuts, data.get("shortcuts") or [], self.active_shortcut_id)
                    elif kind == "scroll_step":
                        GLib.idle_add(self.apply_scroll_step, data.get("scroll_step", 1))
                    elif kind == "scroll_invert":
                        GLib.idle_add(self.apply_scroll_invert, data.get("scroll_invert", False))
                    elif kind == "click":
                        GLib.idle_add(self.apply_click_event, data.get("mode", "scroll"))
                    elif kind == "click_modes":
                        GLib.idle_add(self.apply_click_modes, data.get("click_modes"))
                    elif kind == "captured" and data.get("key") == "turn":
                        GLib.idle_add(self.on_captured, data.get("mods") or [])
                GLib.idle_add(self.status_label.set_text, "Reconectando al servicio...")
            except Exception:
                GLib.idle_add(self.status_label.set_text, "Reconectando al servicio...")
                time.sleep(1)


