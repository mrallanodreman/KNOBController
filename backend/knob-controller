HOST = "127.0.0.1"
PORT = 8766
CONFIG_PATH = Path("/etc/knob-controller/config.json")

EV_SYN = 0
EV_KEY = 1
EV_REL = 2
SYN_REPORT = 0
KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP = 115
KEY_LEFT = 105
KEY_RIGHT = 106
KEY_TAB = 15
KEY_LEFTALT = 56
KEY_RIGHTALT = 100
KEY_LEFTCTRL = 29
KEY_RIGHTCTRL = 97
KEY_LEFTSHIFT = 42
KEY_RIGHTSHIFT = 54
KEY_ENTER = 28
KEY_ESC = 1
KEY_SPACE = 57
KEY_BRIGHTNESSUP = 225
KEY_BRIGHTNESSDOWN = 224
KEY_ZOOMIN = 418
KEY_ZOOMOUT = 419
REL_WHEEL = 8
REL_HWHEEL = 6
BUS_USB = 0x03

# El botón del knob (empuje) manda KEY_MUTE (113) — confirmado en vivo.
KEY_KNOB_CLICK = 113

MODES = {"scroll", "volume", "text", "brightness", "zoom"}
DEFAULT_MODE = "scroll"
DEFAULT_CLICK_MODES = ["scroll", "text"]

# Modificadores espiados desde el teclado normal SIN grabarlo.
MODIFIER_KEYS = {KEY_LEFTALT, KEY_RIGHTALT, KEY_LEFTCTRL, KEY_RIGHTCTRL, KEY_LEFTSHIFT, KEY_RIGHTSHIFT}
MOD_ALT = {KEY_LEFTALT, KEY_RIGHTALT}
MOD_CTRL = {KEY_LEFTCTRL, KEY_RIGHTCTRL}
MOD_SHIFT = {KEY_LEFTSHIFT, KEY_RIGHTSHIFT}
MOD_MAP = {"alt": MOD_ALT, "ctrl": MOD_CTRL, "shift": MOD_SHIFT}
# Inverso de MOD_MAP para traducir un modificador sostenido (código evdev) al
# nombre lógico usado en shortcuts — así la captura sabe qué mantuviste.
CODE_TO_MOD = {
    KEY_LEFTALT: "alt", KEY_RIGHTALT: "alt",
    KEY_LEFTCTRL: "ctrl", KEY_RIGHTCTRL: "ctrl",
    KEY_LEFTSHIFT: "shift", KEY_RIGHTSHIFT: "shift",
}

SHORTCUT_KEYCODES = {
    "tab": KEY_TAB, "left": KEY_LEFT, "right": KEY_RIGHT,
    "leftalt": KEY_LEFTALT, "rightalt": KEY_RIGHTALT,
    "leftctrl": KEY_LEFTCTRL, "rightctrl": KEY_RIGHTCTRL,
    "leftshift": KEY_LEFTSHIFT, "rightshift": KEY_RIGHTSHIFT,
    "enter": KEY_ENTER, "esc": KEY_ESC, "space": KEY_SPACE,
}

# Acciones de tipo "command" se ejecutan con el shell; así puedes mapear el
# knob a CUALQUIER cosa (abrir una app, script, etc).
KEY_EMIT_KEYS = set(SHORTCUT_KEYCODES.values()) | {KEY_VOLUMEUP, KEY_VOLUMEDOWN}

# Acciones predeterminadas que la UI ofrece como alternativa a "comando": el
# usuario captura el modificador y elige una de estas en vez de teclear
# keycodes sueltos.
PRESET_ACTIONS = {
    "switch-app": {"name": "Cambiar de aplicación", "up": ["tab"], "down": ["tab"]},
    "terminal-panes": {"name": "Paneles de terminal", "up": ["right"], "down": ["left"]},
    "confirm-cancel": {"name": "Confirmar / Cancelar", "up": ["enter"], "down": ["esc"]},
    "space": {"name": "Espacio (reproducir / pausar)", "up": ["space"], "down": ["space"]},
}

DEFAULT_SHORTCUTS = [
    {
        "id": "alt-apps",
        "name": "Cambiar de aplicación",
        "mods": ["alt"],
        "type": "key",
        "up": ["tab"], "down": ["tab"],
        "wrap": True, "enabled": True,
    },
    {
        "id": "ctrl-panes",
        "name": "Paneles de terminal",
        "mods": ["ctrl"],
        "type": "key",
        "up": ["right"], "down": ["left"],
        "wrap": False, "enabled": True,
    },
]

IOC_NRBITS = 8
IOC_TYPEBITS = 8
IOC_SIZEBITS = 14
IOC_NRSHIFT = 0
IOC_TYPESHIFT = IOC_NRSHIFT + IOC_NRBITS
IOC_SIZESHIFT = IOC_TYPESHIFT + IOC_TYPEBITS
IOC_DIRSHIFT = IOC_SIZESHIFT + IOC_SIZEBITS
IOC_NONE = 0
IOC_WRITE = 1


def ioc(direction, type_, nr, size):
    return (
        (direction << IOC_DIRSHIFT)
        | (ord(type_) << IOC_TYPESHIFT)
        | (nr << IOC_NRSHIFT)
        | (size << IOC_SIZESHIFT)
    )


UI_DEV_CREATE = ioc(IOC_NONE, "U", 1, 0)
UI_DEV_DESTROY = ioc(IOC_NONE, "U", 2, 0)
UI_SET_EVBIT = ioc(IOC_WRITE, "U", 100, struct.calcsize("i"))
UI_SET_KEYBIT = ioc(IOC_WRITE, "U", 101, struct.calcsize("i"))
UI_SET_RELBIT = ioc(IOC_WRITE, "U", 102, struct.calcsize("i"))
EVIOCGRAB = ioc(IOC_WRITE, "E", 0x90, struct.calcsize("i"))

EVENT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT)


class State:
    def __init__(self):
        self.lock = threading.Lock()
        self.mode = DEFAULT_MODE
        self.click_modes = list(DEFAULT_CLICK_MODES)
        self.scroll_step = 1
        self.scroll_invert = False
        self.device = "not found"
        self.shortcuts = DEFAULT_SHORTCUTS
        self.held_mods = set()
        self.capture_mode = False  # cuando True, el próximo giro "captura" el
        self.clients = []
        self.running = True

    def load(self):
        if CONFIG_PATH.exists():
            try:
                data = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
                self.mode = data.get("mode", DEFAULT_MODE) if data.get("mode") in MODES else DEFAULT_MODE
                self.click_modes = self._validate_click_modes(data.get("click_modes"))
                step = data.get("scroll_step", 1)
                self.scroll_step = step if isinstance(step, int) and 1 <= step <= 10 else 1
                self.scroll_invert = bool(data.get("scroll_invert", False))
                self.shortcuts = self._validate_shortcuts(data.get("shortcuts"))
            except Exception:
                self.mode = DEFAULT_MODE
                self.click_modes = list(DEFAULT_CLICK_MODES)
                self.scroll_step = 1
                self.scroll_invert = False
                self.shortcuts = DEFAULT_SHORTCUTS
        else:
            self.save()

    @staticmethod
    def _validate_click_modes(click_modes):
        if isinstance(click_modes, list) and len(click_modes) == 2:
            a, b = click_modes
            if a in MODES and b in MODES and a != b:
                return [a, b]
        return list(DEFAULT_CLICK_MODES)

    @staticmethod
    def _validate_shortcuts(shortcuts):
        if not isinstance(shortcuts, list) or not shortcuts:
            return DEFAULT_SHORTCUTS
        valid = []
        for sc in shortcuts:
            if not isinstance(sc, dict):
                continue
            mods = [m for m in sc.get("mods", []) if m in MOD_MAP]
            if not mods:
                continue
            stype = sc.get("type", "key")
            if stype == "command":
                if not sc.get("command"):
                    continue
                valid.append({
                    "id": str(sc.get("id", "sc-%d" % len(valid))),
                    "name": str(sc.get("name", "Shortcut")),
                    "mods": mods,
                    "type": "command",
                    "command": str(sc.get("command")),
                    "up": [], "down": [],
                    "wrap": True, "enabled": bool(sc.get("enabled", True)),
                })
                continue
            up = [k for k in sc.get("up", []) if k in SHORTCUT_KEYCODES]
            down = [k for k in sc.get("down", []) if k in SHORTCUT_KEYCODES]
            if not up and not down:
                continue
            valid.append({
                "id": str(sc.get("id", "sc-%d" % len(valid))),
                "name": str(sc.get("name", "Shortcut")),
                "mods": mods,
                "type": "key",
                "up": up or down, "down": down or up,
                "wrap": bool(sc.get("wrap", True)),
                "enabled": bool(sc.get("enabled", True)),
            })
        return valid or DEFAULT_SHORTCUTS

    def save(self):
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = CONFIG_PATH.with_suffix(".tmp")
        tmp.write_text(
            json.dumps(
                {
                    "mode": self.mode,
                    "click_modes": self.click_modes,
                    "scroll_step": self.scroll_step,
                    "scroll_invert": self.scroll_invert,
                    "shortcuts": self.shortcuts,
                },
                indent=2,
            ) + "\n",
            encoding="utf-8",
        )
        os.replace(tmp, CONFIG_PATH)

    def set_shortcuts(self, shortcuts):
        new = self._validate_shortcuts(shortcuts)
        with self.lock:
            self.shortcuts = new
            self.save()
        self.publish({"type": "shortcuts", "shortcuts": new})
        return new

    def set_shortcut_enabled(self, sc_id, enabled):
        new = []
        with self.lock:
            for sc in self.shortcuts:
                item = dict(sc)
                if item["id"] == sc_id:
                    item["enabled"] = bool(enabled)
                new.append(item)
            self.shortcuts = self._validate_shortcuts(new)
            self.save()
        self.publish({"type": "shortcuts", "shortcuts": self.shortcuts})
        return self.shortcuts

    def add_shortcut(self, sc):
        sc["id"] = "sc-%d" % int(time.time())
        new = self._validate_shortcuts(self.shortcuts + [sc])
        with self.lock:
            self.shortcuts = new
            self.save()
        self.publish({"type": "shortcuts", "shortcuts": new})
        return new

    def delete_shortcut(self, sc_id):
        new = [sc for sc in self.shortcuts if sc.get("id") != sc_id]
        with self.lock:
            self.shortcuts = self._validate_shortcuts(new) if new else DEFAULT_SHORTCUTS
            self.save()
        self.publish({"type": "shortcuts", "shortcuts": self.shortcuts})
        return self.shortcuts

    def set_capture(self, enabled):
        with self.lock:
            self.capture_mode = bool(enabled)
        self.publish({"type": "capture", "capture": bool(enabled)})

    def active_shortcut(self):
        held = self.held_mods
        for sc in self.shortcuts:
            if not sc.get("enabled", True):
                continue
            required = set()
            for m in sc["mods"]:
                required |= MOD_MAP[m]
            if required and required <= held:
                return sc
        return None

    def set_mode(self, mode):
        if mode not in MODES:
            raise ValueError("invalid mode")
        with self.lock:
            self.mode = mode
            self.save()
        self.publish({"type": "mode", "mode": mode})

    def toggle_click_mode(self):
        with self.lock:
            current = self.mode
            a, b = self.click_modes
            new_mode = a if current == b else b
            self.mode = new_mode
            self.save()
        self.publish({"type": "mode", "mode": new_mode})
        return new_mode

    def set_click_modes(self, click_modes):
        if not isinstance(click_modes, list) or len(click_modes) != 2:
            raise ValueError("click_modes debe tener exactamente 2 modos")
        a, b = click_modes
        if a not in MODES or b not in MODES or a == b:
            raise ValueError("click_modes inválido")
        with self.lock:
            self.click_modes = [a, b]
            self.save()
        self.publish({"type": "click_modes", "click_modes": self.click_modes})
        return self.click_modes

    def set_scroll_step(self, scroll_step):
        if not isinstance(scroll_step, int) or not (1 <= scroll_step <= 10):
            raise ValueError("invalid scroll_step")
        with self.lock:
            self.scroll_step = scroll_step
            self.save()
        self.publish({"type": "scroll_step", "scroll_step": scroll_step})

    def set_scroll_invert(self, scroll_invert):
        with self.lock:
            self.scroll_invert = bool(scroll_invert)
            self.save()
        self.publish({"type": "scroll_invert", "scroll_invert": self.scroll_invert})

    def publish(self, item):
        dead = []
        for client in list(self.clients):
            try:
                client.put_nowait(item)
            except Exception:
                dead.append(client)
        for client in dead:
            if client in self.clients:
                self.clients.remove(client)


state = State()


def resolve_source():
    data = Path("/proc/bus/input/devices").read_text(encoding="utf-8")
    for block in data.strip().split("\n\n"):
        if 'Name="Evision MEETION Keyboard"' not in block:
            continue
        if "REL=1040" not in block:
            continue
        for line in block.splitlines():
            if line.startswith("H: Handlers="):
                for token in line.split():
                    if token.startswith("event"):
                        return "/dev/input/" + token
    raise RuntimeError("MEETION knob event device not found")


def resolve_keyboard():
    data = Path("/proc/bus/input/devices").read_text(encoding="utf-8")
    for block in data.strip().split("\n\n"):
        if 'Name="Evision MEETION Keyboard"' not in block:
            continue
        if "REL=1040" in block:
            continue
        if "kbd" not in block:
            continue
        for line in block.splitlines():
            if line.startswith("H: Handlers="):
                for token in line.split():
                    if token.startswith("event"):
                        return "/dev/input/" + token
    raise RuntimeError("MEETION keyboard event device not found")


def write_event(fd, ev_type, code, value):
    sec = int(time.time())
    usec = int((time.time() - sec) * 1_000_000)
    os.write(fd, struct.pack(EVENT, sec, usec, ev_type, code, value))


def create_uinput():
    mouse = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(mouse, UI_SET_EVBIT, EV_REL)
    fcntl.ioctl(mouse, UI_SET_RELBIT, REL_WHEEL)
    fcntl.ioctl(mouse, UI_SET_RELBIT, REL_HWHEEL)
    mouse_dev = struct.pack("80sHHHHi" + "i" * 64 * 4, b"KNOBController scroll", BUS_USB, 0x320F, 0x5055, 1, 0, *([0] * 64 * 4))
    os.write(mouse, mouse_dev)
    fcntl.ioctl(mouse, UI_DEV_CREATE)

    keyboard = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(keyboard, UI_SET_EVBIT, EV_KEY)
    for key in KEY_EMIT_KEYS:
        fcntl.ioctl(keyboard, UI_SET_KEYBIT, key)
    keyboard_dev = struct.pack("80sHHHHi" + "i" * 64 * 4, b"KNOBController keys", BUS_USB, 0x320F, 0x5055, 1, 0, *([0] * 64 * 4))
    os.write(keyboard, keyboard_dev)
    fcntl.ioctl(keyboard, UI_DEV_CREATE)
    return mouse, keyboard


def emit_key(fd, key):
    write_event(fd, EV_KEY, key, 1)
    write_event(fd, EV_SYN, SYN_REPORT, 0)
    write_event(fd, EV_KEY, key, 0)
    write_event(fd, EV_SYN, SYN_REPORT, 0)


def emit_chord(fd, keys):
    for key in keys:
        write_event(fd, EV_KEY, key, 1)
    write_event(fd, EV_SYN, SYN_REPORT, 0)
    for key in keys:
        write_event(fd, EV_KEY, key, 0)
    write_event(fd, EV_SYN, SYN_REPORT, 0)


def run_command(cmd):
    try:
        subprocess.Popen(
            shlex.split(cmd),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except Exception:
        return False


def knob_loop():
    source = None
    kbd = None
    mouse = None
    keyboard = None
    while state.running:
        try:
            source_path = resolve_source()
            kbd_path = resolve_keyboard()
            state.device = source_path
            source = os.open(source_path, os.O_RDONLY | os.O_NONBLOCK)
            kbd = os.open(kbd_path, os.O_RDONLY | os.O_NONBLOCK)
            mouse, keyboard = create_uinput()
            fcntl.ioctl(source, EVIOCGRAB, 1)
            print(f"KNOBController active: {source_path} (kbd {kbd_path})", flush=True)
            while state.running:
                ready, _, _ = select.select([source, kbd], [], [], 0.5)
                if not ready:
                    continue
                for fd in ready:
                    if fd is kbd:
                        kdata = os.read(kbd, EVENT_SIZE * 64)
                        for idx in range(0, len(kdata) // EVENT_SIZE * EVENT_SIZE, EVENT_SIZE):
                            _sec, _usec, ev_type, code, value = struct.unpack(EVENT, kdata[idx : idx + EVENT_SIZE])
                            if ev_type != EV_KEY or code not in MODIFIER_KEYS:
                                continue
                            with state.lock:
                                if value:
                                    state.held_mods.add(code)
                                else:
                                    state.held_mods.discard(code)
                        continue
                    data = os.read(source, EVENT_SIZE * 64)
                    for idx in range(0, len(data) // EVENT_SIZE * EVENT_SIZE, EVENT_SIZE):
                        _sec, _usec, ev_type, code, value = struct.unpack(EVENT, data[idx : idx + EVENT_SIZE])
                        if ev_type != EV_KEY or value != 1:
                            continue
                        if code == KEY_KNOB_CLICK:
                            if state.capture_mode:
                                state.set_capture(False)
                                state.publish({"type": "captured", "key": "click"})
                            else:
                                new_mode = state.toggle_click_mode()
                                state.publish({"type": "click", "mode": new_mode})
                            continue
                        if code == KEY_VOLUMEUP:
                            delta = 1
                        elif code == KEY_VOLUMEDOWN:
                            delta = -1
                        else:
                            continue

                        # MODO CAPTURA: en lugar de ejecutar, registramos el
                        # modificador sostenido para que la UI complete el
                        # shortcut (comando o acción predeterminada).
                        if state.capture_mode:
                            with state.lock:
                                mods = sorted({CODE_TO_MOD[c] for c in state.held_mods if c in CODE_TO_MOD})
                            state.set_capture(False)
                            state.publish({"type": "captured", "key": "turn", "direction": "up" if delta > 0 else "down", "mods": mods})
                            continue

                        with state.lock:
                            mode = state.mode
                            scroll_step = state.scroll_step
                            scroll_invert = state.scroll_invert
                            shortcut = state.active_shortcut()

                        if shortcut is not None:
                            keys = shortcut["up"] if delta > 0 else shortcut["down"]
                            if shortcut.get("type") == "command":
                                run_command(shortcut["command"])
                            else:
                                emit_chord(keyboard, [SHORTCUT_KEYCODES[k] for k in keys])
                            state.publish({"type": "turn", "delta": delta, "mode": mode, "shortcut": shortcut["id"]})
                            continue

                        if mode == "scroll":
                            wheel_delta = -delta if scroll_invert else delta
                            write_event(mouse, EV_REL, REL_WHEEL, wheel_delta * scroll_step)
                            write_event(mouse, EV_SYN, SYN_REPORT, 0)
                        elif mode == "text":
                            text_delta = -delta if scroll_invert else delta
                            emit_key(keyboard, KEY_RIGHT if text_delta > 0 else KEY_LEFT)
                        elif mode == "brightness":
                            emit_key(keyboard, KEY_BRIGHTNESSDOWN if delta < 0 else KEY_BRIGHTNESSUP)
                        elif mode == "zoom":
                            emit_key(keyboard, KEY_ZOOMIN if delta > 0 else KEY_ZOOMOUT)
                        else:
                            emit_key(keyboard, KEY_VOLUMEUP if delta > 0 else KEY_VOLUMEDOWN)
                        state.publish({"type": "turn", "delta": delta, "mode": mode})
        except Exception as exc:
            print(f"KNOBController loop error: {exc}", flush=True)
            time.sleep(2)
        finally:
            for fd, destroy in [(source, False), (kbd, False), (mouse, True), (keyboard, True)]:
                if fd is None:
                    continue
                try:
                    if not destroy:
                        fcntl.ioctl(fd, EVIOCGRAB, 0)
                    else:
                        fcntl.ioctl(fd, UI_DEV_DESTROY)
                except Exception:
                    pass
                try:
                    os.close(fd)
                except Exception:
                    pass
            source = kbd = mouse = keyboard = None


class Handler(BaseHTTPRequestHandler):
    def log_message(self, _format, *_args):
        return

    def send_json(self, data, status=200):
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/":
            body = HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("content-type", "text/html; charset=utf-8")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/api/status":
            self.send_json({
                "mode": state.mode,
                "click_modes": state.click_modes,
                "device": state.device,
                "scroll_step": state.scroll_step,
                "scroll_invert": state.scroll_invert,
                "shortcuts": state.shortcuts,
                "active_shortcut": state.active_shortcut()["id"] if state.active_shortcut() else None,
                "capture": state.capture_mode,
                "modes": list(MODES),
                "presets": PRESET_ACTIONS,
            })
        elif self.path == "/events":
            client = queue.Queue(maxsize=128)
            state.clients.append(client)
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
            self.send_header("cache-control", "no-cache")
            self.send_header("connection", "keep-alive")
            self.end_headers()
            try:
                self.wfile.write(f"data: {json.dumps({'type':'mode','mode':state.mode})}\n\n".encode("utf-8"))
                self.wfile.flush()
                while state.running:
                    try:
                        item = client.get(timeout=15)
                    except queue.Empty:
                        self.wfile.write(b": heartbeat\n\n")
                        self.wfile.flush()
                        continue
                    self.wfile.write(f"data: {json.dumps(item)}\n\n".encode("utf-8"))
                    self.wfile.flush()
            except Exception:
                if client in state.clients:
                    state.clients.remove(client)
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        length = int(self.headers.get("content-length", "0"))
        data = json.loads(self.rfile.read(length) or b"{}")
        if self.path == "/api/mode":
            try:
                state.set_mode(data.get("mode"))
                self.send_json({"mode": state.mode})
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
        elif self.path == "/api/click-modes":
            try:
                new = state.set_click_modes(data.get("click_modes"))
                self.send_json({"click_modes": new})
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
        elif self.path == "/api/scroll-step":
            try:
                state.set_scroll_step(int(data.get("scroll_step")))
                self.send_json({"scroll_step": state.scroll_step})
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
        elif self.path == "/api/scroll-invert":
            state.set_scroll_invert(bool(data.get("scroll_invert")))
            self.send_json({"scroll_invert": state.scroll_invert})
        elif self.path == "/api/shortcuts":
            try:
                new = state.set_shortcuts(data.get("shortcuts"))
                self.send_json({"shortcuts": new})
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
        elif self.path == "/api/shortcut-enabled":
            try:
                new = state.set_shortcut_enabled(data.get("id"), data.get("enabled"))
                self.send_json({"shortcuts": new})
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
        elif self.path == "/api/shortcut-add":
            try:
                new = state.add_shortcut(data.get("shortcut") or {})
                self.send_json({"shortcuts": new})
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
        elif self.path == "/api/shortcut-delete":
            try:
                new = state.delete_shortcut(data.get("id"))
                self.send_json({"shortcuts": new})
            except Exception as exc:
                self.send_json({"error": str(exc)}, 400)
        elif self.path == "/api/capture":
            state.set_capture(bool(data.get("capture")))
            self.send_json({"capture": state.capture_mode})
        else:
            self.send_response(404)
            self.end_headers()


def stop(_signum, _frame):
    state.running = False


